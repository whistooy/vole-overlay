<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE pkgmetadata SYSTEM "https://www.gentoo.org/dtd/metadata.dtd">
<pkgmetadata>
	<maintainer type="person">
		<email>maintainer-needed@gentoo.org</email>
	</maintainer>
	<upstream>
		<remote-id type="github">reF1nd/sing-box</remote-id>
	</upstream>
	<use>
		<flag name="acme">Enable ACME TLS certificate support</flag>
		<flag name="ccm">Enable ciphertext configuration mode support</flag>
		<flag name="clash-api">Enable Clash API support</flag>
		<flag name="cloudflared">Enable Cloudflare UDP-over-TCP tunnel support</flag>
		<flag name="dhcp">Enable DHCP based configuration</flag>
		<flag name="ebpf">Enable eBPF inbound support (requires kernel headers)</flag>
