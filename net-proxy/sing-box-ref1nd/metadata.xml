		<flag name="naive">Enable NaiveProxy (Cronet/Chrome network stack) outbound support</flag>
		<flag name="ocm">Enable OpenConnect mode support</flag>
		<flag name="openconnect">Enable OpenConnect outbound support</flag>
		<flag name="openvpn">Enable OpenVPN outbound support</flag>
		<flag name="quic">Enable QUIC based transports</flag>
		<flag name="tailscale">Enable Tailscale endpoint support</flag>
		<flag name="usbip">Enable USB/IP support</flag>
		<flag name="utls">Enable uTLS for TLS fingerprint mimicry</flag>
